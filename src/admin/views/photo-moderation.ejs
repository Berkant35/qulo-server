<%- include('_header') %>
<h2 style="margin-bottom: 20px;">Photo Moderation (<%= total %>) <small style="color:#888; font-weight:normal;">— model could not decide; a human must</small></h2>
<div style="margin-bottom: 20px; display:flex; gap:8px;">
  <% [['review', 'Needs review'], ['explicit', 'Banned'], ['safe', 'Safe'], ['error', 'Error (retrying)'], ['all', 'All']].forEach(function(opt) { %>
  <a href="/admin/photo-moderation?verdict=<%= opt[0] %>"
     class="btn <%= verdict === opt[0] ? 'btn-primary' : '' %>"
     style="padding:6px 14px; font-size:13px; <%= verdict === opt[0] ? '' : 'background:#fff; color:#555; border:1px solid #ddd;' %> border-radius:6px; text-decoration:none;">
    <%= opt[1] %>
  </a>
  <% }); %>
</div>
<div class="card">
  <table>
    <thead><tr><th>Photo</th><th>User</th><th>Model reason</th><th>Verdict</th><th>Checked</th><th></th></tr></thead>
    <tbody>
      <% if (rows.length === 0) { %>
      <tr><td colspan="6" style="color:#888;">Nothing here.</td></tr>
      <% } %>
      <% rows.forEach(function(r) { %>
      <tr>
        <td>
          <a href="<%= r.photo_url %>" target="_blank" rel="noopener">
            <img src="<%= r.photo_url %>" alt="" style="width:96px;height:96px;object-fit:cover;border-radius:6px;filter:blur(6px);" onmouseover="this.style.filter='none'" onmouseout="this.style.filter='blur(6px)'">
          </a>
          <% if (!r.hala_profilde) { %><div style="font-size:11px;color:#888;">removed from profile</div><% } %>
        </td>
        <td>
          <a href="/admin/users/<%= r.user_id %>" style="color:#a855f7;"><%= r.name || r.user_id.substring(0,8) %></a>
          <div style="font-size:12px;color:#666;"><%= r.email || '-' %></div>
          <% if (r.is_banned) { %><span class="badge badge-resolved">banned</span><% } %>
        </td>
        <td style="max-width:420px;font-size:12px;"><%= r.reason || '-' %><div style="color:#999;"><%= r.model || '' %> · attempts <%= r.attempts %></div></td>
        <td><span class="badge badge-<%= r.verdict === 'review' ? 'pending' : r.verdict === 'safe' ? 'resolved' : 'reviewed' %>"><%= r.verdict %></span></td>
        <td><%= new Date(r.checked_at).toLocaleString() %></td>
        <td style="white-space:nowrap;">
          <% if (r.verdict !== 'explicit') { %>
          <form method="POST" action="/admin/photo-moderation/<%= r.id %>/action" style="display:inline;" onsubmit="return confirm('Ban this user for sexual content? They get an email with an appeal link.')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="action" value="ban">
            <input type="hidden" name="return_to" value="/admin/photo-moderation?verdict=<%= verdict %>&page=<%= page %>">
            <button type="submit" class="btn btn-danger btn-sm">Ban</button>
          </form>
          <% } %>
          <% if (r.verdict !== 'safe') { %>
          <form method="POST" action="/admin/photo-moderation/<%= r.id %>/action" style="display:inline;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="action" value="safe">
            <input type="hidden" name="return_to" value="/admin/photo-moderation?verdict=<%= verdict %>&page=<%= page %>">
            <button type="submit" class="btn btn-sm" style="background:#d1fae5;color:#065f46;">Safe</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<% if (totalPages > 1) { %>
<div class="pagination">
  <% for (var i = 1; i <= totalPages; i++) { %>
  <a href="/admin/photo-moderation?verdict=<%= verdict %>&page=<%= i %>" class="<%= i === page ? 'active' : '' %>"><%= i %></a>
  <% } %>
</div>
<% } %>
<%- include('_footer') %>
