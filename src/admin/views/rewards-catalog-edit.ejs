<%- include('_header') %>
<h2 style="margin-bottom:12px;">&#127752; <%= item && item.id ? 'Ürünü Düzenle' : 'Yeni Ürün' %></h2>
<%- include('_rewards-nav') %>

<form method="POST" action="<%= item && item.id ? '/admin/rewards/catalog/' + item.id : '/admin/rewards/catalog' %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <div class="card" style="max-width:640px;">
    <label>Marka *</label>
    <select name="brand_key" style="width:100%;margin-bottom:12px;">
      <% brands.forEach((b) => { %><option value="<%= b %>" <%= item && item.brand_key === b ? 'selected' : '' %>><%= b %></option><% }) %>
    </select>

    <label>Ülke * (para birimi ülkeden gelir)</label>
    <select name="country_code" style="width:100%;margin-bottom:12px;">
      <% countries.forEach((c) => { %><option value="<%= c.country_code %>" <%= item && item.country_code === c.country_code ? 'selected' : '' %>><%= c.country_code %> (<%= c.currency %>)</option><% }) %>
    </select>

    <label>Kupür (yerel para) *</label>
    <input name="face_value" type="number" step="0.01" min="0.01" value="<%= item ? item.face_value : '' %>" style="width:100%;margin-bottom:12px;" />

    <label>Tedarikçi maliyeti (USD)</label>
    <input id="cost_usd" name="cost_usd" type="number" step="0.01" min="0.01" value="<%= item && item.cost_usd != null ? item.cost_usd : '' %>" style="width:100%;margin-bottom:4px;" />
    <p style="color:#666;font-size:12px;margin-top:0;margin-bottom:12px;">
      Önerilen rainbow fiyatı: <strong id="suggested">-</strong> (1 rainbow ≈ $<%= usdPerRainbow %>)
      <button type="button" id="use-suggested" class="btn btn-sm" style="margin-left:8px;">Öneriyi kullan</button>
    </p>

    <label>Rainbow fiyatı *</label>
    <input id="rainbow_price" name="rainbow_price" type="number" step="1" min="1" value="<%= item ? item.rainbow_price : '' %>" style="width:100%;margin-bottom:12px;" />

    <label>Sıra</label>
    <input name="sort_order" type="number" step="1" value="<%= item ? item.sort_order : 0 %>" style="width:100%;margin-bottom:12px;" />

    <label>Logo URL (https)</label>
    <input name="logo_url" value="<%= item && item.logo_url ? item.logo_url : '' %>" placeholder="https://..." style="width:100%;margin-bottom:12px;" />

    <label style="display:block;margin-bottom:12px;">
      <input type="checkbox" name="is_active" <%= item && item.is_active ? 'checked' : '' %> /> Aktif (ülke kapalıyken yalnız test admin görür)
    </label>

    <button type="submit" class="btn btn-primary"><%= item && item.id ? 'Güncelle' : 'Oluştur' %></button>
    <a href="/admin/rewards/catalog" class="btn">Vazgeç</a>
  </div>
</form>

<script>
  // Canlı önizleme; sunucudaki `suggestedRainbowPrice` (src/utils/rewards.ts) ile aynı formül.
  (function () {
    var usd = <%- JSON.stringify(usdPerRainbow) %>;
    var cost = document.getElementById('cost_usd');
    var out = document.getElementById('suggested');
    var price = document.getElementById('rainbow_price');
    function update() {
      var c = parseFloat(cost.value);
      if (!(c > 0) || !(usd > 0)) { out.textContent = '-'; out.dataset.value = ''; return; }
      var s = Math.max(1, Math.ceil(Math.round((c / usd) * 1e6) / 1e6));
      out.textContent = s;
      out.dataset.value = String(s);
    }
    cost.addEventListener('input', update);
    document.getElementById('use-suggested').addEventListener('click', function () {
      if (out.dataset.value) price.value = out.dataset.value;
    });
    update();
  })();
</script>
<%- include('_footer') %>
