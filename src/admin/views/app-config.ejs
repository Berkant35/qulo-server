<%- include('_header') %>
<h2 style="margin-bottom: 20px;">App Configuration</h2>

<% if (success) { %>
<div class="alert" style="background: #d1fae5; color: #065f46; border: 1px solid #a7f3d0;">Configuration updated successfully.</div>
<% } %>
<% if (error) { %>
<div class="alert" style="background: #fee2e2; color: #991b1b; border: 1px solid #fecaca;">Update failed: <%= error %></div>
<% } %>

<form method="POST" action="/admin/app-config">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <!-- Version Control -->
  <div class="card">
    <h3 style="margin-bottom: 16px;">Version Control</h3>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
      <div>
        <label style="display:block; font-size:13px; font-weight:600; color:#555; margin-bottom:4px;">Min Version iOS</label>
        <input type="text" name="min_version_ios" value="<%= config?.min_version_ios || '' %>" placeholder="e.g. 1.0.0" style="width:100%;">
      </div>
      <div>
        <label style="display:block; font-size:13px; font-weight:600; color:#555; margin-bottom:4px;">Min Version Android</label>
        <input type="text" name="min_version_android" value="<%= config?.min_version_android || '' %>" placeholder="e.g. 1.0.0" style="width:100%;">
      </div>
      <div>
        <label style="display:block; font-size:13px; font-weight:600; color:#555; margin-bottom:4px;">Latest Version iOS</label>
        <input type="text" name="latest_version_ios" value="<%= config?.latest_version_ios || '' %>" placeholder="e.g. 1.2.0" style="width:100%;">
      </div>
      <div>
        <label style="display:block; font-size:13px; font-weight:600; color:#555; margin-bottom:4px;">Latest Version Android</label>
        <input type="text" name="latest_version_android" value="<%= config?.latest_version_android || '' %>" placeholder="e.g. 1.2.0" style="width:100%;">
      </div>
    </div>
    <div style="margin-top: 16px;">
      <label style="display:flex; align-items:center; gap:8px; font-size:14px; cursor:pointer;">
        <input type="checkbox" name="is_force_update_enabled" <%= config?.is_force_update_enabled ? 'checked' : '' %>>
        <span>Force Update Enabled</span>
      </label>
      <p style="font-size:12px; color:#999; margin-top:4px;">When enabled, users below the minimum version will be forced to update.</p>
    </div>
  </div>

  <!-- Store URLs -->
  <div class="card">
    <h3 style="margin-bottom: 16px;">Store URLs</h3>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
      <div>
        <label style="display:block; font-size:13px; font-weight:600; color:#555; margin-bottom:4px;">App Store URL (iOS)</label>
        <input type="text" name="store_url_ios" value="<%= config?.store_url_ios || '' %>" placeholder="https://apps.apple.com/..." style="width:100%;">
      </div>
      <div>
        <label style="display:block; font-size:13px; font-weight:600; color:#555; margin-bottom:4px;">Play Store URL (Android)</label>
        <input type="text" name="store_url_android" value="<%= config?.store_url_android || '' %>" placeholder="https://play.google.com/..." style="width:100%;">
      </div>
    </div>
  </div>

  <!-- Maintenance -->
  <div class="card">
    <h3 style="margin-bottom: 16px;">Maintenance Mode</h3>
    <div style="margin-bottom: 16px;">
      <label style="display:flex; align-items:center; gap:8px; font-size:14px; cursor:pointer;">
        <input type="checkbox" name="is_maintenance" <%= config?.is_maintenance ? 'checked' : '' %>>
        <span>Maintenance Mode Active</span>
      </label>
      <p style="font-size:12px; color:#999; margin-top:4px;">When enabled, users will see a maintenance screen instead of the app.</p>
    </div>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
      <div>
        <label style="display:block; font-size:13px; font-weight:600; color:#555; margin-bottom:4px;">Maintenance Message (TR)</label>
        <textarea name="maintenance_message_tr" rows="3" style="width:100%; padding:8px 12px; border:1px solid #ddd; border-radius:4px; font-size:14px; font-family:inherit; resize:vertical;"><%= config?.maintenance_message_tr || '' %></textarea>
      </div>
      <div>
        <label style="display:block; font-size:13px; font-weight:600; color:#555; margin-bottom:4px;">Maintenance Message (EN)</label>
        <textarea name="maintenance_message_en" rows="3" style="width:100%; padding:8px 12px; border:1px solid #ddd; border-radius:4px; font-size:14px; font-family:inherit; resize:vertical;"><%= config?.maintenance_message_en || '' %></textarea>
      </div>
    </div>
  </div>

  <!-- Seed AI Sohbet -->
  <div class="card">
    <h3 style="margin-bottom: 16px;">Seed AI Sohbet (test profilleri)</h3>
    <div style="margin-bottom: 16px;">
      <label style="display:flex; align-items:center; gap:8px; font-size:14px; cursor:pointer;">
        <input type="checkbox" name="seed_reply_enabled" <%= config?.seed_reply_enabled ? 'checked' : '' %>>
        <span>Seed AI cevapları aktif</span>
      </label>
      <p style="font-size:12px; color:#999; margin-top:4px;">Açıkken seed profiller gelen mesajlara karakterlerine uygun AI cevabı yazar. Yalnızca test hesapları (<code>is_seed_profile</code> + <code>is_test_account</code>) etkilenir; gerçek kullanıcılara asla yazılmaz.</p>
    </div>
    <div>
      <label style="display:flex; align-items:center; gap:8px; font-size:14px; cursor:pointer;">
        <input type="checkbox" name="seed_reply_fast_mode" <%= config?.seed_reply_fast_mode ? 'checked' : '' %>>
        <span>Hızlı test modu</span>
      </label>
      <p style="font-size:12px; color:#999; margin-top:4px;">Cevap gecikmeleri saniyelere sıkışır; uyku ve mesai penceresi yok sayılır. Sadece test için — gerçekçi ritim isteniyorsa kapalı bırakın.</p>
    </div>
  </div>

  <!-- Fotograf moderasyonu -->
  <div class="card">
    <h3 style="margin-bottom: 16px;">Fotoğraf Moderasyonu (NVIDIA NIM)</h3>
    <div>
      <label style="display:flex; align-items:center; gap:8px; font-size:14px; cursor:pointer;">
        <input type="checkbox" name="photo_moderation_enabled" <%= config?.photo_moderation_enabled ? 'checked' : '' %>>
        <span>Otomatik fotoğraf taraması ve ban aktif</span>
      </label>
      <p style="font-size:12px; color:#999; margin-top:4px;">Her 5 dakikada gerçek kullanıcıların taranmamış profil fotoğrafları görsel modelden geçer. Cinsel içerik iki modelde de kesinleşirse hesap banlanır, kullanıcıya itiraz bağlantılı e-posta gider. Sunucuda <code>NVIDIA_API_KEY</code> yoksa çalışmaz. Şüpheli ama kesinleşmeyenler <code>photo_moderation_checks</code> tablosunda <code>review</code> olarak bekler.</p>
    </div>
  </div>

  <% if (config && config.discover_dormant_days !== undefined && config.discover_dormant_days !== null) { %>
  <!-- Discover siralamasi (migration 074) -->
  <div class="card">
    <h3 style="margin-bottom: 16px;">Discover Sıralaması</h3>
    <div>
      <label style="display:block; font-size:14px; margin-bottom:6px;">Uyuyan hesap eşiği (gün)</label>
      <input type="number" name="discover_dormant_days" min="0" max="365" step="1" value="<%= config.discover_dormant_days %>" style="width:120px;">
      <p style="font-size:12px; color:#999; margin-top:4px;">Bu kadar gündür görülmeyen (<code>last_seen_at</code>) adaylar Discover'da aktif gerçek adayların arkasına sıralanır; listeden çıkarılmaz. 0 = kapalı. Varsayılan 14.</p>
    </div>
  </div>
  <% } %>

  <% if (config && config.mutual_match_enabled !== undefined && config.mutual_match_enabled !== null) { %>
  <!-- Karşılıklı eşleşme (migration 075) -->
  <div class="card">
    <h3 style="margin-bottom: 16px;">Karşılıklı Eşleşme</h3>
    <div>
      <input type="hidden" name="mutual_match_field" value="1">
      <label style="display:flex; align-items:center; gap:8px; font-size:14px; cursor:pointer;">
        <input type="checkbox" name="mutual_match_enabled" <%= config.mutual_match_enabled ? 'checked' : '' %>>
        <span>Discover, beğeni ve quiz'de karşılıklı cinsiyet tercihi kuralı aktif</span>
      </label>
      <p style="font-size:12px; color:#999; margin-top:4px;">Açıkken iki kişi yalnız birbirinin aradığı cinsiyetteyse birbirini görür (<code>compatibility.ts</code>). Kapalıyken eski tek yönlü filtre çalışır. Sorun olursa buradan kapat — 60 sn içinde tüm sunucularda geçerli.</p>
    </div>
  </div>
  <% } %>

  <div style="text-align: right;">
    <button type="submit" class="btn btn-primary" style="padding: 10px 32px; font-size: 15px;">Save Configuration</button>
  </div>
</form>
<%- include('_footer') %>
