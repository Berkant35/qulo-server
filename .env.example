PORT=3001
NODE_ENV=development
# Cron'lar yalniz NODE_ENV=production'da kendiliginden baslar (yerel sunucu prod DB'ye bagli).
# DIKKAT: CRON_ENABLED=true DOKUZ isin HEPSINI bu .env'deki DB'ye (yerelde = prod!) karsi baslatir:
# cift push/kampanya, cift foto moderasyonu/ban e-postasi. Tek bir isi denemek icin /admin/crons'tan
# yalniz o isi baslat (surec ici). CRON_ENABLED=false uretimde de kapatir. Bos = tanimsiz.
# CRON_ENABLED=true
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FIREBASE_SERVICE_ACCOUNT=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
APP_URL=http://localhost:3000
ADMIN_SESSION_SECRET=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_ALLOWED_IPS=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY=
IAP_SKIP_VALIDATION=
# Tuketilebilir webhook kredisi. Bos = KAPALI (dogrulama modu: webhook yalniz iz satiri yazar).
# Webhook transaction_id'si istemci yolunun referansiyla iOS VE Android'de ayni cikmadan true yapma (cift kredi).
# RC_CONSUMABLE_WEBHOOK_CREDIT=true
GEMINI_API_KEY=
NVIDIA_API_KEY=
# Ban itirazi bildirimi (bos = EMAIL_FROM) ve e-postalardaki sunucu baglantilari
BAN_APPEAL_NOTIFY_EMAIL=
API_BASE_URL=https://qulo-server-production.up.railway.app
SEED_LLM_PROVIDER=gemini
